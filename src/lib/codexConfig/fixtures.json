[
  {
    "name": "explicit empty effort can be cleared without discarding its comment",
    "source": "model_reasoning_effort = '' # preserved\nmodel = 'keep'\n",
    "patch": { "reasoningEffort": "" },
    "expected": " # preserved\nmodel = 'keep'\n",
    "fields": { "reasoningEffort": "", "model": "keep" }
  },
  {
    "name": "clearing reasoning leaves its comment and newer model",
    "source": "model_reasoning_effort = 'high' # keep reasoning note\r\nmodel = 'custom-model'\r\n",
    "patch": { "reasoningEffort": "" },
    "expected": " # keep reasoning note\r\nmodel = 'custom-model'\r\n",
    "fields": { "reasoningEffort": "", "model": "custom-model" }
  },
  {
    "name": "absent reasoning remains absent during other edits",
    "source": "model = 'old'\n",
    "patch": { "model": "new" },
    "expected": "model = \"new\"\n",
    "fields": { "reasoningEffort": "", "model": "new" }
  },
  {
    "name": "provider-defined reasoning levels remain strings",
    "source": "'model_reasoning_effort' = 'max' # keep\n",
    "patch": { "reasoningEffort": "none" },
    "expected": "'model_reasoning_effort' = \"none\" # keep\n",
    "fields": { "reasoningEffort": "none" }
  },
  {
    "name": "quoted provider, comments, BOM and CRLF",
    "source": "\ufeffmodel_provider = 'team.example'\r\nmodel = 'old' # keep\r\n[model_providers.\"team.example\"] # header\r\nbase_url = 'https://old.test'\r\nrequires_openai_auth = false\r\n",
    "patch": { "model": "new" },
    "expected": "\ufeffmodel_provider = 'team.example'\r\nmodel = \"new\" # keep\r\n[model_providers.\"team.example\"] # header\r\nbase_url = 'https://old.test'\r\nrequires_openai_auth = false\r\n",
    "fields": { "modelProvider": "team.example", "model": "new", "baseUrl": "https://old.test" }
  },
  {
    "name": "inline provider and MCP contents",
    "source": "model_provider = 'team.example'\nmodel_providers = { 'team.example' = { base_url = 'https://old.test', requires_openai_auth = false } }\nmcp_servers = { 'fs.local' = { command = 'node', args = ['keep'] } }\n",
    "patch": { "baseUrl": "https://new.test" },
    "expected": "model_provider = 'team.example'\nmodel_providers = { 'team.example' = { base_url = \"https://new.test\", requires_openai_auth = false } }\nmcp_servers = { 'fs.local' = { command = 'node', args = ['keep'] } }\n",
    "fields": { "modelProvider": "team.example", "baseUrl": "https://new.test", "mcpServers": ["fs.local"] }
  },
  {
    "name": "implicit provider with child table",
    "source": "model_provider = 'custom'\n[model_providers.custom.headers]\nkey = 'keep'\n",
    "patch": { "baseUrl": "https://new.test" },
    "expected": "model_provider = 'custom'\nmodel_providers.custom.base_url = \"https://new.test\"\n[model_providers.custom.headers]\nkey = 'keep'\n",
    "fields": { "modelProvider": "custom", "baseUrl": "https://new.test" }
  },
  {
    "name": "precise integer replacement",
    "source": "model_context_window = 9_007_199_254_740_993 # exact\n",
    "patch": { "modelContextWindow": "9223372036854775807" },
    "expected": "model_context_window = 9223372036854775807 # exact\n",
    "fields": { "modelContextWindow": "9223372036854775807" }
  },
  {
    "name": "limit removal preserves its comment",
    "source": "model_context_window = 400_000 # user note\nmodel = 'keep'\n",
    "patch": { "modelContextWindow": "" },
    "expected": " # user note\nmodel = 'keep'\n",
    "fields": { "model": "keep", "modelContextWindow": "" }
  }
]
