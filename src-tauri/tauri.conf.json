{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCHub",
  "version": "1.6.8",
  "identifier": "com.cchub.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "CCHub",
        "visible": false,
        "width": 1300,
        "height": 722,
        "minWidth": 975,
        "minHeight": 542,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:* https:;"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "CCHub - AI 编程工具管理平台"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Moresl",
    "homepage": "https://github.com/Moresyl/cchub",
    "copyright": "Copyright (c) 2026 Moresl",
    "category": "DeveloperTool",
    "shortDescription": "AI 编程工具配置切换工作台",
    "longDescription": "在一个紧凑的桌面工作台中管理、检查并切换 AI 编程工具配置。",
    "windows": {
      "wix": {
        "upgradeCode": "0f196973-5299-5133-b433-da6f8f0cbd91",
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "uninstallerHeaderImage": "installer/nsis-uninstall-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "customLanguageFiles": {
          "SimpChinese": "installer/languages/SimpChinese.nsh",
          "English": "installer/languages/English.nsh"
        },
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cchub"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Moresyl/cchub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MUU4QzcwRkUzNTcxNDUKUldSRmNUWCtjSXdlWjZtUy8rZyszdWpuY1lBTkZkL2x5U1pwak1WSWcwR1lJeFl5Z0pzK3Bwd1QK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
